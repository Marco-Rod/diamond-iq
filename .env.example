DATABASE_URL=postgresql+asyncpg://diamondiq:diamondiq@localhost:5432/diamondiq

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=30

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# LLM routing
PRIMARY_LLM_PROVIDER=ollama
FALLBACK_LLM_PROVIDER=

AI_MAX_TOOL_ITERATIONS=3
AI_MAX_TOOL_CALLS_PER_CHAT=6
AI_MAX_TOTAL_TOKENS_PER_CHAT=12000

# Provider resilience
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY_SECONDS=0.5